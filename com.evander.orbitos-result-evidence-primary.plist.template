<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.evander.orbitos-result-evidence-primary</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/evander/.local/share/orbitos-result-runtime/orbitos-result-evidence-primary.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/evander/.npm-global/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/evander/Library/Logs/orbitos-result-evidence-primary.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/evander/Library/Logs/orbitos-result-evidence-primary.launchd.err.log</string>
</dict>
</plist>
